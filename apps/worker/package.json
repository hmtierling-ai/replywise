{
  "name": "@replywise/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:int": "vitest run -c vitest.int.config.ts"
  },
  "dependencies": {
    "@replywise/config": "workspace:*",
    "@replywise/db": "workspace:*",
    "@replywise/observability": "workspace:*",
    "@replywise/queue": "workspace:*",
    "bullmq": "^6.7.6",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^6.0.0",
    "pino": "^10.4.0",
    "postgres": "^4.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "dotenv-cli": "^11.1.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
