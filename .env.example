# Do not set NODE_ENV here: next dev/build/start and the worker set it themselves, and a
# value leaking into `next build` breaks prerendering.
APP_URL=http://localhost:3000
DATABASE_URL=postgres://replywise:replywise@localhost:5432/replywise
DATABASE_URL_TEST=postgres://replywise:replywise@localhost:5432/replywise_test
REDIS_URL=redis://localhost:6379
REDIS_URL_TEST=redis://localhost:6379
# Key-encryption keys, newest last. Generate one with:
# node -e "console.log('v1:' + require('crypto').randomBytes(32).toString('base64'))"
LOCAL_KEKS=
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Optional: "Sign in with Google" for app login only (scopes: openid email profile)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LOG_LEVEL=info
# Mailbox connection (M2). Separate from GOOGLE_CLIENT_ID above, which is only for app login.
# Setup steps: README.md → "Connecting mailboxes in development".
# Redirect URI to register: http://localhost:3000/api/oauth/gmail/callback
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Redirect URI to register: http://localhost:3000/api/oauth/outlook/callback
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
